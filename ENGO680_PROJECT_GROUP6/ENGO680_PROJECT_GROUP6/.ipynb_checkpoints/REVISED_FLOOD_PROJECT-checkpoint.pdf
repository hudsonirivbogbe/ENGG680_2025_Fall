    "booster = best_xgb.get_booster()\n",
    "\n",
    "# Gain-based importance (keys are actual feature names)\n",
    "score_dict = booster.get_score(importance_type='gain')\n",
    "\n",
    "xgb_importances = pd.Series(score_dict)\n",
    "\n",
    "plt.figure(figsize=(8,6))\n",
    "xgb_importances.sort_values(ascending=True).plot(kind='barh')\n",
    "plt.title(\"XGBoost Feature Importances (Gain)\")\n",
    "plt.xlabel(\"Gain\")\n",
    "plt.show()\n"
   ]
  },
