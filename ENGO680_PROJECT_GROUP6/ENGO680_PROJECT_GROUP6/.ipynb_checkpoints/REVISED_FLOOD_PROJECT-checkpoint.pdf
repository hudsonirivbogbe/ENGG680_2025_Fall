    "# ============================================================\n",
    "# RECOMPUTE PROBABILITIES (fixes NameError)\n",
    "# ============================================================\n",
    "rf_test_proba = rf.predict_proba(X_test)[:, 1]\n",
    "xgb_test_proba = xgb.predict_proba(X_test)[:, 1]\n",
    "\n",
    "# ============================================================\n",
    "# COMBINED ROC CURVE (RF + XGBoost)\n",
    "# ============================================================\n",
    "from sklearn.metrics import roc_curve, roc_auc_score\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "\n",
    "# --- Random Forest ---\n",
    "fpr_rf, tpr_rf, _ = roc_curve(y_test, rf_test_proba)\n",
    "auc_rf = roc_auc_score(y_test, rf_test_proba)\n",
    "plt.plot(fpr_rf, tpr_rf, label=f\"Random Forest (AUC = {auc_rf:.3f})\")\n",
    "\n",
    "# --- XGBoost ---\n",
    "fpr_xgb, tpr_xgb, _ = roc_curve(y_test, xgb_test_proba)\n",
    "auc_xgb = roc_auc_score(y_test, xgb_test_proba)\n",
    "plt.plot(fpr_xgb, tpr_xgb, label=f\"XGBoost (AUC = {auc_xgb:.3f})\")\n",
    "\n",
    "# --- Chance line ---\n",
    "plt.plot([0, 1], [0, 1], \"k--\", label=\"Chance\")\n",
    "\n",
    "plt.title(\"Combined ROC Curve – Random Forest vs XGBoost\")\n",
    "plt.xlabel(\"False Positive Rate\")\n",
    "plt.ylabel(\"True Positive Rate\")\n",
    "plt.grid(True)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
  },
