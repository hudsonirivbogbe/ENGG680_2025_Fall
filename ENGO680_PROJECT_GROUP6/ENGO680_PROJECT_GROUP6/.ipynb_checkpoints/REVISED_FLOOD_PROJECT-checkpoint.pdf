    "# Export LULC to Google Drive\n",
    "task = ee.batch.Export.image.toDrive(\n",
    "    image=rec_lulc,\n",
    "    description='LULC_Export',\n",
    "    folder='GEE_EXPORTS',      \n",
    "    fileNamePrefix='LULC',\n",
    "    region=study_area,\n",
    "    scale=30,\n",
    "    crs='EPSG:4326',\n",
    "    maxPixels=1e13\n",
    ")\n",
    "task.start()\n",
    "\n",
    "while task.active():\n",
    "    status = task.status()\n",
    "    print(\"Task state:\", status['state'])\n",
    "    time.sleep(10)\n",
    "\n",
    "status = task.status()\n",
    "print(\"✅ Export finished with state:\", status['state'])"
   ]
  },
