    }
   ],
   "source": [
    "# Derivation of other input data from DEM\n",
    "dem = \"DEM.tif\"\n",
    "slope = \"SLOPE.tif\"\n",
    "twi = \"TWI.tif\"\n",
    "spi = \"SPI.tif\"\n",
    "curvature = \"TOTAL_CURVATURE.tif\"\n",
    "\n",
    "filled_dem = \"filled_DEM.tif\"\n",
    "wbt.fill_depressions(dem, output=filled_dem)\n",
    "\n",
    "wbt.slope(filled_dem, slope, 1.0, 'degrees')\n",
    "\n",
    "flow_accum = \"flow_accum.tif\"\n",
    "wbt.d8_flow_accumulation(filled_dem, flow_accum, \"specific_catchment_area\")\n",
    "\n",
    "flow_dir = \"flow_dir.tif\"\n",
    "wbt.d8_pointer(filled_dem, flow_dir)\n",
    "\n",
    "wbt.run_tool(\"WetnessIndex\", [f\"--sca={flow_accum}\", f\"--slope={slope}\", f\"-o={twi}\"])\n",
    "\n",
    "slope_rad = \"slope_radians.tif\"\n",
    "wbt.slope(filled_dem, slope_rad, 1.0, 'radians')\n",
    "\n",
    "wbt.run_tool(\"StreamPowerIndex\", [f\"--sca={flow_accum}\", f\"--slope={slope_rad}\", f\"-o={spi}\"])\n",
    "\n",
    "wbt.run_tool(\"TotalCurvature\", [f\"-i={filled_dem}\", f\"-o={curvature}\"])"
   ]
  },
