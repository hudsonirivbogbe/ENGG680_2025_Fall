   "source": [
    "study_area = study_area_fc.geometry()\n",
    "\n",
    "task = ee.batch.Export.image.toDrive(\n",
    "    image=dem,\n",
    "    description='DEM_export',\n",
    "    folder='GEE_EXPORTS',\n",
    "    fileNamePrefix='DEM',\n",
    "    region=study_area,\n",
    "    scale=30,\n",
    "    crs='EPSG:4326',\n",
    "    maxPixels=1e13\n",
    ")\n",
    "task.start()\n",
    "\n",
    "import time\n",
    "\n",
    "while task.active():\n",
    "    status = task.status()\n",
    "    print(\"Task state:\", status['state'])\n",
    "    time.sleep(10)\n",
    "\n",
    "status = task.status()\n",
    "print(\"✅ Export finished with state:\", status['state'])"
   ]
  },
