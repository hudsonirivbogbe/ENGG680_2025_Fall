   "source": [
    "from sklearn.utils.class_weight import compute_class_weight\n",
    "from sklearn.metrics import roc_auc_score\n",
    "from sklearn.metrics import ConfusionMatrixDisplay\n",
    "\n",
    "class_weights = compute_class_weight(\"balanced\", classes=np.unique(y_train), y=y_train)\n",
    "cw = {0: class_weights[0], 1: class_weights[1]}\n",
    "print(\"Class Weights:\", cw)\n",
    "\n",
    "\n",
    "rf_1 = RandomForestClassifier(\n",
    "    n_estimators=300,\n",
    "    max_depth=None,\n",
    "    class_weight=cw,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "rf_1.fit(X_train, y_train)\n",
    "\n",
    "neg, pos = np.bincount(y_train)\n",
    "scale = neg / pos\n",
    "print(\"XGB scale_pos_weight:\", scale)\n",
    "\n",
    "xgb_1 = XGBClassifier(\n",
    "    n_estimators=400,\n",
    "    learning_rate=0.05,\n",
    "    max_depth=6,\n",
    "    subsample=0.9,\n",
    "    colsample_bytree=0.9,\n",
    "    objective=\"binary:logistic\",\n",
    "    scale_pos_weight=scale,\n",
    "    eval_metric=\"logloss\",\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "xgb_1.fit(X_train, y_train)\n",
    "\n",
    "rf_train_acc_1 = accuracy_score(y_train, rf.predict(X_train))\n",
    "rf_test_acc_1  = accuracy_score(y_test,  rf.predict(X_test))\n",
    "\n",
    "xgb_train_acc_1 = accuracy_score(y_train, xgb.predict(X_train))\n",
    "xgb_test_acc_1 = accuracy_score(y_test,  xgb.predict(X_test))\n",
    "\n",
    "print(\"\\n===== ACCURACY RESULTS =====\")\n",
    "print(f\"RF  Train Accuracy: {rf_train_acc_1:.4f}\")\n",
    "print(f\"RF  Test  Accuracy: {rf_test_acc_1:.4f}\")\n",
    "print(f\"XGB Train Accuracy: {xgb_train_acc_1:.4f}\")\n",
    "print(f\"XGB Test  Accuracy: {xgb_test_acc_1:.4f}\")\n",
    "\n",
    "\n",
    "rf_test_proba  = rf.predict_proba(X_test)[:, 1]\n",
    "xgb_test_proba = xgb.predict_proba(X_test)[:, 1]\n",
    "\n",
    "rf_auc_1  = roc_auc_score(y_test, rf_test_proba)\n",
    "xgb_auc_1 = roc_auc_score(y_test, xgb_test_proba)\n",
    "\n",
    "print(\"\\n===== AUC SCORES =====\")\n",
    "print(f\"Random Forest AUC: {rf_auc:.4f}\")\n",
    "print(f\"XGBoost AUC:       {xgb_auc:.4f}\")\n",
    "\n",
    "\n",
    "fpr_rf, tpr_rf, _ = roc_curve(y_test, rf_test_proba)\n",
    "fpr_xgb, tpr_xgb, _ = roc_curve(y_test, xgb_test_proba)\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "plt.plot(fpr_rf, tpr_rf, label=f\"RF (AUC={rf_auc:.3f})\")\n",
    "plt.plot(fpr_xgb, tpr_xgb, label=f\"XGBoost (AUC={xgb_auc:.3f})\")\n",
    "plt.plot([0,1], [0,1], \"k--\")\n",
    "\n",
    "plt.xlabel(\"False Positive Rate\")\n",
    "plt.ylabel(\"True Positive Rate\")\n",
    "plt.title(\"Combined ROC Curve – RF vs XGBoost\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n",
    "rf_pred_1  = rf_1.predict(X_test)\n",
    "xgb_pred_1 = xgb_1.predict(X_test)\n",
    "\n",
    "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ======================================================\n",
    "# PREDICTIONS\n",
    "# ======================================================\n",
    "rf_pred_1 = rf_1.predict(X_test)\n",
    "xgb_pred_1 = xgb_1.predict(X_test)\n",
    "\n",
    "# ======================================================\n",
    "# CONFUSION MATRIX — RANDOM FOREST\n",
    "# ======================================================\n",
    "cm_rf = confusion_matrix(y_test, rf_pred_1)\n",
    "\n",
    "plt.figure(figsize=(6, 5))\n",
    "ConfusionMatrixDisplay(cm_rf).plot(cmap=\"Reds\", values_format=\"d\")\n",
    "plt.title(\"Random Forest - Confusion Matrix\")\n",
    "plt.show()\n",
    "\n",
    "# ======================================================\n",
    "# CONFUSION MATRIX — XGBOOST\n",
    "# ======================================================\n",
    "cm_xgb = confusion_matrix(y_test, xgb_pred_1)\n",
    "\n",
    "plt.figure(figsize=(6, 5))\n",
    "ConfusionMatrixDisplay(cm_xgb).plot(cmap=\"Greens\", values_format=\"d\")\n",
    "plt.title(\"XGBoost - Confusion Matrix\")\n",
    "plt.show()"
   ]
  },
