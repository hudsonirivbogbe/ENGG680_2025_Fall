   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.model_selection import train_test_split, StratifiedKFold, RandomizedSearchCV\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score, classification_report, confusion_matrix\n",
    "from xgboost import XGBClassifier\n",
    "\n",
    "# =====================================================\n",
    "# 1) STRATIFIED TRAIN–TEST SPLIT\n",
    "# =====================================================\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y,\n",
    "    test_size=0.3,\n",
    "    stratify=y,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "# =====================================================\n",
    "# 2) COMPUTE SCALE_POS_WEIGHT (imbalance handling)\n",
    "# =====================================================\n",
    "neg = sum(y_train == 0)\n",
    "pos = sum(y_train == 1)\n",
    "scale_pos_weight = neg / pos\n",
    "\n",
    "print(f\"scale_pos_weight = {scale_pos_weight:.2f}\")\n",
    "\n",
    "# =====================================================\n",
    "# 3) INITIAL XGBOOST MODEL (for RandomizedSearch)\n",
    "# =====================================================\n",
    "xgb = XGBClassifier(\n",
    "    objective=\"binary:logistic\",\n",
    "    eval_metric=\"logloss\",\n",
    "    scale_pos_weight=scale_pos_weight,\n",
    "    tree_method=\"auto\",\n",
    "    random_state=42,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "# =====================================================\n",
    "# 4) PARAMETER DISTRIBUTIONS FOR RANDOMIZED SEARCH\n",
    "# =====================================================\n",
    "param_dist = {\n",
    "    \"n_estimators\": [200, 300, 400, 500],\n",
    "    \"max_depth\": [4, 6, 8, 10],\n",
    "    \"learning_rate\": [0.01, 0.03, 0.05, 0.1],\n",
    "    \"subsample\": [0.6, 0.7, 0.8, 1.0],\n",
    "    \"colsample_bytree\": [0.6, 0.7, 0.8, 1.0],\n",
    "    \"gamma\": [0, 0.1, 0.3, 0.5, 1],\n",
    "    \"min_child_weight\": [1, 3, 5, 7]\n",
    "}\n",
    "\n",
    "# =====================================================\n",
    "# 5) 5-FOLD STRATIFIED CV FOR SEARCH\n",
    "# =====================================================\n",
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "random_search_xgb = RandomizedSearchCV(\n",
    "    estimator=xgb,\n",
    "    param_distributions=param_dist,\n",
    "    n_iter=25,                     # 25 random combos\n",
    "    scoring=\"f1_macro\",            # good for imbalance\n",
    "    cv=cv,\n",
    "    verbose=1,\n",
    "    random_state=42,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "# ---- Fit RandomizedSearchCV ----\n",
    "random_search_xgb.fit(X_train, y_train)\n",
    "\n",
    "# =====================================================\n",
    "# 6) PRINT BEST PARAMETERS + BEST CV SCORE\n",
    "# =====================================================\n",
    "print(\"\\n===== BEST PARAMETERS (XGBoost) =====\")\n",
    "print(random_search_xgb.best_params_)\n",
    "\n",
    "print(\"\\nBest 5-Fold CV F1 Macro Score:\")\n",
    "print(random_search_xgb.best_score_)\n",
    "\n",
    "# =====================================================\n",
    "# 7) RETRAIN BEST MODEL\n",
    "# =====================================================\n",
    "best_xgb = random_search_xgb.best_estimator_\n",
    "best_xgb.fit(X_train, y_train)\n",
    "\n",
    "# =====================================================\n",
    "# 8) PREDICT + METRICS\n",
    "# =====================================================\n",
    "xgb_pred = best_xgb.predict(X_test)\n",
    "xgb_prob = best_xgb.predict_proba(X_test)[:, 1]\n",
    "\n",
    "print(\"\\n===== XGBOOST TEST SET RESULTS =====\")\n",
    "print(\"Accuracy:\", accuracy_score(y_test, xgb_pred))\n",
    "print(\"Precision:\", precision_score(y_test, xgb_pred))\n",
    "print(\"Recall:\", recall_score(y_test, xgb_pred))\n",
    "print(\"F1 Score:\", f1_score(y_test, xgb_pred))\n",
    "print(\"AUC:\", roc_auc_score(y_test, xgb_prob))\n",
    "\n",
    "print(\"\\nConfusion Matrix:\\n\", confusion_matrix(y_test, xgb_pred))\n",
    "\n",
    "print(\"\\nClassification Report:\\n\", classification_report(y_test, xgb_pred))\n"
   ]
  },
