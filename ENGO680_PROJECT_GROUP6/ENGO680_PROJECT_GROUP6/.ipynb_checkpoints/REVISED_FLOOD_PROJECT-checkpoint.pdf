   "source": [
    "# =======================================================\n",
    "# 1) MASK OUT PERMANENT WATERBODIES IN FLOOD INVENTORY\n",
    "# =======================================================\n",
    "\n",
    "print(\"\\n===== STEP 1: MASKING PERMANENT WATER =====\")\n",
    "\n",
